# Optional GPU layer offload for llama.cpp. Keep 0 for CPU; use -1 only if the
# installed llama-cpp-python wheel was built for a supported GPU backend.
EDUAI_N_GPU_LAYERS=0

# The reranker is optional. Download it once with .\download_reranker.ps1.
EDUAI_ENABLE_RERANKER=true
EDUAI_RERANKER_DEVICE=cpu
# A smaller CPU candidate pool reduces reranking time; accepted range is 1-64.
EDUAI_RERANK_CANDIDATES=12
# Standard RRF rank constant; adjust only when comparing retrieval evaluations.
EDUAI_RRF_RANK_CONSTANT=60

# The answer plus prompt must fit in this context window. 8192 enables the full
# optional long-answer allowance; lower values reduce long-answer output tokens.
EDUAI_CONTEXT_WINDOW=8192
# Detailed tutor answers target about 300-450 words; lower this to reduce generation time.
EDUAI_MAX_NEW_TOKENS=700
# Optional tutor long-form mode (about 1,150-2,000 words, slower on CPU).
EDUAI_LONG_MAX_NEW_TOKENS=3500

# MySQL credentials belong in .streamlit/secrets.toml or ignored .env, never here.
EDUAI_OCR_BATCH_SIZE=12
# Independent review-extraction jobs; keep at 1 on low-memory machines.
# Accepted range: 1-3. Model inference remains serialized to control RAM use.
EDUAI_PREVIEW_WORKERS=2

# Optional local diagram understanding through Ollama. Install Ollama once,
# then run .\download_diagram_model.ps1 to pull the vision model once.
EDUAI_ENABLE_DIAGRAM_VISION=true
EDUAI_VISION_BASE_URL=http://127.0.0.1:11434
EDUAI_VISION_MODEL=qwen2.5vl:3b
# "figures" analyzes only pages/images flagged by a lightweight diagram check.
# Legacy value "all" now uses the same filter and never renders every PDF page.
EDUAI_VISION_PDF_MODE=figures
EDUAI_VISION_MAX_PAGES=20
